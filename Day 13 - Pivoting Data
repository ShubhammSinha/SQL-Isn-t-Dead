-- ============================================
-- View raw tables
-- ============================================

SELECT * FROM dim_products;
SELECT * FROM fact_orders ORDER BY created_at;

-- ============================================
-- STEP 1: Revenue per product per category per month
-- Run this first to understand the raw numbers
-- before the pivot
-- ============================================

SELECT
    strftime('%Y-%m', o.created_at) AS month,
    p.category,
    p.product_name,
    SUM(o.amount)                   AS revenue
FROM fact_orders o
JOIN dim_products p ON o.product_id = p.product_id
GROUP BY 1, 2, 3
ORDER BY month, category, revenue DESC;

-- ============================================
-- STEP 2: Rank products within each category
-- per month using RANK()
-- Run this to see the ranking before pivoting
-- ============================================

WITH ranked_products AS (
    SELECT
        strftime('%Y-%m', o.created_at) AS month,
        p.category,
        p.product_name,
        SUM(o.amount)                   AS revenue,
        RANK() OVER (
            PARTITION BY
                strftime('%Y-%m', o.created_at),
                p.category
            ORDER BY SUM(o.amount) DESC
        ) AS rnk
    FROM fact_orders o
    JOIN dim_products p ON o.product_id = p.product_id
    GROUP BY 1, 2, 3
)
SELECT * FROM ranked_products
ORDER BY month, category, rnk;

-- ============================================
-- STEP 3: Pivot — top product per category per month
-- The full query from the post
-- ============================================

WITH ranked_products AS (
    SELECT
        strftime('%Y-%m', o.created_at) AS month,
        p.category,
        p.product_name,
        SUM(o.amount)                   AS revenue,
        RANK() OVER (
            PARTITION BY
                strftime('%Y-%m', o.created_at),
                p.category
            ORDER BY SUM(o.amount) DESC
        ) AS rnk
    FROM fact_orders o
    JOIN dim_products p ON o.product_id = p.product_id
    GROUP BY 1, 2, 3
)
SELECT
    month,
    MAX(CASE WHEN category = 'Electronics' AND rnk = 1
        THEN product_name END)          AS top_Electronics,
    MAX(CASE WHEN category = 'Electronics' AND rnk = 1
        THEN revenue END)               AS electronics_revenue,
    MAX(CASE WHEN category = 'Office' AND rnk = 1
        THEN product_name END)          AS top_Office,
    MAX(CASE WHEN category = 'Office' AND rnk = 1
        THEN revenue END)               AS office_revenue
FROM ranked_products
GROUP BY month
ORDER BY month;

-- ============================================
-- BONUS: Extended pivot — top 2 per category
-- Change rnk = 1 to rnk <= 2 and add columns
-- ============================================

WITH ranked_products AS (
    SELECT
        strftime('%Y-%m', o.created_at) AS month,
        p.category,
        p.product_name,
        SUM(o.amount)                   AS revenue,
        RANK() OVER (
            PARTITION BY
                strftime('%Y-%m', o.created_at),
                p.category
            ORDER BY SUM(o.amount) DESC
        ) AS rnk
    FROM fact_orders o
    JOIN dim_products p ON o.product_id = p.product_id
    GROUP BY 1, 2, 3
)
SELECT
    month,
    MAX(CASE WHEN category = 'Electronics' AND rnk = 1 THEN product_name END) AS electronics_1st,
    MAX(CASE WHEN category = 'Electronics' AND rnk = 2 THEN product_name END) AS electronics_2nd,
    MAX(CASE WHEN category = 'Office'      AND rnk = 1 THEN product_name END) AS office_1st,
    MAX(CASE WHEN category = 'Office'      AND rnk = 2 THEN product_name END) AS office_2nd
FROM ranked_products
GROUP BY month
ORDER BY month;
