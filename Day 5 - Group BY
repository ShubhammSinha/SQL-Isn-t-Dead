SELECT * FROM orders;

-- ============================================
-- TRICK 1: GROUP BY column position
-- Group by month using position instead of
-- repeating the full expression
-- ============================================

-- Without position (verbose):
SELECT
    strftime('%Y-%m', created_at) AS month,
    SUM(amount)                   AS total_revenue
FROM orders
GROUP BY strftime('%Y-%m', created_at)
ORDER BY month;

-- With position (cleaner):
SELECT
    strftime('%Y-%m', created_at) AS month,
    SUM(amount)                   AS total_revenue
FROM orders
GROUP BY 1
ORDER BY 1;

-- ============================================
-- TRICK 2: HAVING vs WHERE
-- HAVING filters AFTER aggregation
-- WHERE filters BEFORE aggregation
-- ============================================

-- Wrong approach: WHERE cannot use aggregate functions
-- (uncomment to see the error)
-- SELECT product, COUNT(*) AS total_orders
-- FROM orders
-- WHERE COUNT(*) > 3
-- GROUP BY product;

-- Right approach: use HAVING to filter groups
SELECT
    product,
    COUNT(*) AS total_orders
FROM orders
GROUP BY product
HAVING COUNT(*) > 2
ORDER BY total_orders DESC;

-- Combine both: WHERE filters rows first, HAVING filters groups after
SELECT
    product,
    COUNT(*)    AS total_orders,
    SUM(amount) AS total_revenue
FROM orders
WHERE created_at >= '2026-05-10'   -- filter rows first
GROUP BY product
HAVING COUNT(*) > 1                -- then filter groups
ORDER BY total_revenue DESC;

-- ============================================
-- TRICK 3: COUNT(*) vs COUNT(column)
-- COUNT(*) includes NULLs
-- COUNT(column) excludes NULLs
-- ============================================

SELECT
    product,
    COUNT(*)           AS total_orders,
    COUNT(promo_code)  AS orders_with_promo,
    COUNT(*) - COUNT(promo_code) AS orders_without_promo
FROM orders
GROUP BY product
ORDER BY total_orders DESC;

-- ============================================
-- TRICK 4: GROUP BY with CASE WHEN
-- Bucket orders by size on the fly
-- No need to alter the table
-- ============================================

SELECT
    CASE
        WHEN amount < 25             THEN 'Small'
        WHEN amount BETWEEN 25 AND 75 THEN 'Medium'
        ELSE                              'Large'
    END          AS order_size,
    COUNT(*)     AS total_orders,
    SUM(amount)  AS total_revenue,
    ROUND(AVG(amount), 2) AS avg_order_value
FROM orders
GROUP BY 1
ORDER BY total_revenue DESC;
