-- ============================================
-- SECTION A: SQLite-compatible workaround
-- Get the most recent order per customer
-- using a subquery + ROW_NUMBER
-- ============================================

-- Step 1: see all orders with ROW_NUMBER applied
SELECT
    o.customer_id,
    c.name,
    o.product,
    o.amount,
    o.created_at,
    ROW_NUMBER() OVER (
        PARTITION BY o.customer_id
        ORDER BY o.created_at DESC
    ) AS rn
FROM orders o
JOIN customers c ON o.customer_id = c.id;

-- Step 2: wrap in subquery and filter rn = 1
SELECT
    customer_id,
    name,
    product,
    amount,
    created_at
FROM (
    SELECT
        o.customer_id,
        c.name,
        o.product,
        o.amount,
        o.created_at,
        ROW_NUMBER() OVER (
            PARTITION BY o.customer_id
            ORDER BY o.created_at DESC
        ) AS rn
    FROM orders o
    JOIN customers c ON o.customer_id = c.id
)
WHERE rn = 1
ORDER BY customer_id;

-- ============================================
-- Bonus: Top 2 most recent orders per customer
-- Just change rn = 1 to rn <= 2
-- ============================================

SELECT
    customer_id,
    name,
    product,
    amount,
    created_at
FROM (
    SELECT
        o.customer_id,
        c.name,
        o.product,
        o.amount,
        o.created_at,
        ROW_NUMBER() OVER (
            PARTITION BY o.customer_id
            ORDER BY o.created_at DESC
        ) AS rn
    FROM orders o
    JOIN customers c ON o.customer_id = c.id
)
WHERE rn <= 2
ORDER BY customer_id, created_at DESC;

