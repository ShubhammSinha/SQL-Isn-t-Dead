-- ============================================
-- View raw tables
-- ============================================

SELECT * FROM regions;
SELECT * FROM customers;
SELECT * FROM orders;

-- ============================================
-- APPROACH 1: Clever SQL
-- Find premium customers whose total revenue
-- is above the overall average
-- Hard to read, painful to debug
-- ============================================

SELECT customer_id, SUM(amount) AS total_revenue
FROM orders
WHERE customer_id IN (
    SELECT id FROM customers WHERE country IN (
        SELECT country FROM regions WHERE tier = 'premium'
    )
)
GROUP BY 1
HAVING SUM(amount) > (
    SELECT AVG(total) FROM (
        SELECT customer_id, SUM(amount) AS total
        FROM orders
        GROUP BY 1
    )
)
ORDER BY total_revenue DESC;

-- ============================================
-- APPROACH 2: Readable SQL
-- Exact same result — broken into clear steps
-- Easy to read, easy to debug, easy to hand over
-- ============================================

WITH premium_countries AS (

    -- Step 1: which countries are premium tier?
    SELECT country
    FROM regions
    WHERE tier = 'premium'

),
premium_customers AS (

    -- Step 2: which customers are in those countries?
    SELECT id AS customer_id
    FROM customers
    WHERE country IN (SELECT country FROM premium_countries)

),
customer_revenue AS (

    -- Step 3: total revenue per customer
    SELECT
        customer_id,
        SUM(amount) AS total_revenue
    FROM orders
    GROUP BY customer_id

),
avg_revenue AS (

    -- Step 4: what is the overall average revenue?
    SELECT AVG(total_revenue) AS avg_rev
    FROM customer_revenue

)

-- Step 5: return premium customers above average
SELECT
    c.name,
    cr.customer_id,
    cr.total_revenue,
    ROUND(ar.avg_rev, 2) AS avg_revenue_benchmark
FROM customer_revenue cr
JOIN avg_revenue      ar ON cr.total_revenue > ar.avg_rev
JOIN customers         c ON cr.customer_id   = c.id
WHERE cr.customer_id IN (SELECT customer_id FROM premium_customers)
ORDER BY cr.total_revenue DESC;
