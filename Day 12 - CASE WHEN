-- ============================================
-- PATTERN 1: Bucketing continuous values
-- Turn raw amounts into human-readable labels
-- ============================================

SELECT
    id          AS order_id,
    product,
    amount,
    CASE
        WHEN amount < 25              THEN 'Small'
        WHEN amount BETWEEN 25 AND 75 THEN 'Medium'
        ELSE                               'Large'
    END AS order_size
FROM orders
ORDER BY amount;

-- ============================================
-- PATTERN 2: Conditional aggregation
-- One query, one scan — multiple breakdowns
-- ============================================

SELECT
    COUNT(*)                                              AS total_orders,
    SUM(CASE WHEN c.country = 'DE' THEN o.amount ELSE 0 END) AS revenue_de,
    SUM(CASE WHEN c.country = 'US' THEN o.amount ELSE 0 END) AS revenue_us,
    SUM(CASE WHEN c.country = 'FR' THEN o.amount ELSE 0 END) AS revenue_fr,
    SUM(CASE WHEN c.country = 'PT' THEN o.amount ELSE 0 END) AS revenue_pt
FROM orders o
JOIN customers c ON o.customer_id = c.id;

-- Breakdown by category as well
SELECT
    c.country,
    COUNT(*)                                                        AS total_orders,
    SUM(CASE WHEN o.category = 'Electronics' THEN o.amount ELSE 0 END) AS electronics_revenue,
    SUM(CASE WHEN o.category = 'Office'      THEN o.amount ELSE 0 END) AS office_revenue
FROM orders o
JOIN customers c ON o.customer_id = c.id
GROUP BY c.country
ORDER BY total_orders DESC;

-- ============================================
-- PATTERN 3: Handling edge cases
-- Division by zero — try it broken, then fixed
-- ============================================

-- Broken: crashes or returns NULL unexpectedly on Standing Desk
SELECT
    product,
    total_revenue,
    total_orders,
    ROUND(total_revenue / total_orders, 2) AS avg_order_value_broken
FROM product_summary;

-- Fixed: handle zero orders with CASE WHEN
SELECT
    product,
    total_revenue,
    total_orders,
    CASE
        WHEN total_orders = 0 THEN NULL
        ELSE ROUND(total_revenue / total_orders, 2)
    END AS avg_order_value
FROM product_summary
ORDER BY total_revenue DESC;

-- ============================================
-- PATTERN 4: Dynamic sorting with CASE WHEN
-- Force category order, then sort by amount
-- ============================================

SELECT
    id AS order_id,
    product,
    category,
    amount
FROM orders
ORDER BY
    CASE category
        WHEN 'Electronics' THEN 1
        WHEN 'Office'      THEN 2
        ELSE                    3
    END,
    amount DESC;
