-- ============================================
-- View raw tables
-- ============================================

SELECT * FROM customers;
SELECT * FROM orders;

-- ============================================
-- NULL TRAP 1: Filtering NULLs the wrong way
-- ============================================

-- Wrong: returns 0 rows even though NULLs exist
SELECT * FROM orders
WHERE promo_code = NULL;

-- Right: use IS NULL
SELECT * FROM orders
WHERE promo_code IS NULL;

-- Right: use IS NOT NULL
SELECT * FROM orders
WHERE promo_code IS NOT NULL;

-- ============================================
-- NULL TRAP 2: NULLs in arithmetic
-- ============================================

-- Without COALESCE: NULL discount produces NULL final_price
SELECT
    id,
    product,
    amount,
    discount,
    amount - discount           AS final_price_broken,
    amount - COALESCE(discount, 0) AS final_price_fixed
FROM orders;

-- ============================================
-- NULL TRAP 3: NULLs in aggregations
-- AVG ignores NULLs — know when that matters
-- ============================================

-- Only 3 of 10 orders have a discount
-- AVG(discount) averages across those 3 only
SELECT
    COUNT(*)                        AS total_orders,
    COUNT(discount)                 AS orders_with_discount,
    ROUND(AVG(discount), 2)         AS avg_discount_excluding_nulls,
    ROUND(AVG(COALESCE(discount,0)),2) AS avg_discount_including_nulls
FROM orders;

-- ============================================
-- NULL TRAP 4: NULLs in LEFT JOINs
-- ============================================

-- LEFT JOIN: customers with no orders appear with NULL product
SELECT
    c.name,
    c.country,
    o.product,
    o.amount
FROM customers c
LEFT JOIN orders o ON c.id = o.customer_id
ORDER BY c.id;

-- Filtering after LEFT JOIN silently drops non-buyers
-- Wrong: Erik disappears from results
SELECT
    c.name,
    o.product
FROM customers c
LEFT JOIN orders o ON c.id = o.customer_id
WHERE o.product = 'iPhone Case';

-- Right: keep non-buyers explicitly
SELECT
    c.name,
    o.product
FROM customers c
LEFT JOIN orders o ON c.id = o.customer_id
WHERE o.product = 'iPhone Case'
   OR o.product IS NULL;
