-- ============================================
-- Schema: customers & orders (with discount)
-- Used in: SQL Isn't Dead — Post 8
-- NULL Handling
-- Database: SQLite
-- ============================================

CREATE TABLE customers (
    id          INTEGER PRIMARY KEY AUTOINCREMENT,
    name        TEXT    NOT NULL,
    country     TEXT    NOT NULL,
    created_at  TEXT    NOT NULL
);

CREATE TABLE orders (
    id          INTEGER PRIMARY KEY AUTOINCREMENT,
    customer_id INTEGER NOT NULL REFERENCES customers(id),
    product     TEXT    NOT NULL,
    amount      REAL    NOT NULL,
    discount    REAL,               -- nullable: not all orders have a discount
    promo_code  TEXT,               -- nullable: not all orders have a promo code
    created_at  TEXT    NOT NULL
);

