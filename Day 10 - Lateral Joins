-- ============================================
-- View raw tables
-- ============================================

SELECT * FROM dim_customers;
SELECT * FROM fact_orders;

-- ============================================
-- SECTION A: SQLite correlated subquery
-- ============================================

-- Use case 1: Most expensive order per customer
SELECT
    c.name,
    (
        SELECT product
        FROM fact_orders f
        WHERE f.customer_id = c.customer_id
        ORDER BY amount DESC
        LIMIT 1
    ) AS top_product,
    (
        SELECT amount
        FROM fact_orders f
        WHERE f.customer_id = c.customer_id
        ORDER BY amount DESC
        LIMIT 1
    ) AS top_amount
FROM dim_customers c
ORDER BY top_amount DESC;

-- Use case 2: Most recent order per customer
SELECT
    c.name,
    (
        SELECT product
        FROM fact_orders f
        WHERE f.customer_id = c.customer_id
        ORDER BY created_at DESC
        LIMIT 1
    ) AS latest_product,
    (
        SELECT created_at
        FROM fact_orders f
        WHERE f.customer_id = c.customer_id
        ORDER BY created_at DESC
        LIMIT 1
    ) AS latest_order_date
FROM dim_customers c
ORDER BY latest_order_date DESC;

-- Use case 3: Total orders and revenue per customer
-- alongside their single most expensive order
SELECT
    c.name,
    COUNT(f.order_id)   AS total_orders,
    SUM(f.amount)       AS total_revenue,
    (
        SELECT product
        FROM fact_orders sub
        WHERE sub.customer_id = c.customer_id
        ORDER BY amount DESC
        LIMIT 1
    ) AS most_expensive_product
FROM dim_customers c
LEFT JOIN fact_orders f ON c.customer_id = f.customer_id
GROUP BY c.customer_id, c.name
ORDER BY total_revenue DESC;

