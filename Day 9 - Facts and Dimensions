-- ============================================
-- View raw tables
-- Notice: fact_orders has NO names, NO categories
-- Just IDs, numbers, and timestamps
-- ============================================

SELECT * FROM dim_customers;
SELECT * FROM dim_products;
SELECT * FROM fact_orders;

-- ============================================
-- The query from the post:
-- Facts join OUT to dimensions
-- ============================================

SELECT
    d.name             AS customer_name,
    p.product_name,
    p.category,
    f.amount,
    f.created_at
FROM fact_orders f
JOIN dim_customers d ON f.customer_id = d.customer_id
JOIN dim_products  p ON f.product_id  = p.product_id
WHERE f.created_at >= '2026-05-01'
ORDER BY f.created_at;

-- ============================================
-- Bonus: why this model scales
-- Rename a product category ONCE in dim_products
-- and every order automatically reflects it —
-- no need to touch fact_orders at all
-- ============================================

UPDATE dim_products
SET category = 'Tech Accessories'
WHERE category = 'Electronics';

-- Re-run the same query — categories are updated everywhere
-- without a single row in fact_orders being touched
SELECT
    d.name             AS customer_name,
    p.product_name,
    p.category,
    f.amount,
    f.created_at
FROM fact_orders f
JOIN dim_customers d ON f.customer_id = d.customer_id
JOIN dim_products  p ON f.product_id  = p.product_id
ORDER BY f.created_at;
