-- ============================================
-- Schema: fact_orders, dim_customers, dim_products
-- Used in: SQL Isn't Dead — Post 11
-- Facts vs Dimensions
-- Database: SQLite
-- ============================================

CREATE TABLE dim_customers (
    customer_id   INTEGER PRIMARY KEY AUTOINCREMENT,
    name          TEXT    NOT NULL,
    country       TEXT    NOT NULL,
    signup_date   TEXT    NOT NULL
);

CREATE TABLE dim_products (
    product_id    INTEGER PRIMARY KEY AUTOINCREMENT,
    product_name  TEXT    NOT NULL,
    category      TEXT    NOT NULL,
    price         REAL    NOT NULL
);

CREATE TABLE fact_orders (
    order_id      INTEGER PRIMARY KEY AUTOINCREMENT,
    customer_id   INTEGER NOT NULL REFERENCES dim_customers(customer_id),
    product_id    INTEGER NOT NULL REFERENCES dim_products(product_id),
    amount        REAL    NOT NULL,
    created_at    TEXT    NOT NULL
);

